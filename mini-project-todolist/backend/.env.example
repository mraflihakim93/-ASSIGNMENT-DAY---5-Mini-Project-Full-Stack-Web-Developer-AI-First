# ============================================================
# Backend Environment Variables (CONTOH)
# File : backend/.env.example
# Salin file ini menjadi ".env" lalu isi nilainya.
# JANGAN commit file .env ke GitHub (sudah masuk .gitignore).
# ============================================================

# Port server Express
PORT=3000

# Koneksi MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ganti-dengan-password-mysql-anda
DB_NAME=todo_list

# JWT untuk autentikasi (buat string random yang panjang)
JWT_SECRET=ubah-ini-jadi-random-string-panjang
